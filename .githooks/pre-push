#!/usr/bin/env bash
#
# pre-push hook: blocks direct pushes to protected branches.
#
# Install once per clone: ./scripts/install-hooks.sh
# Intentional one-off bypass (repository setup only): git push --no-verify
#
set -uo pipefail

PROTECTED_BRANCHES="main develop"
ZERO="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue

    case "$remote_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    branch="${remote_ref#refs/heads/}"

    for protected in $PROTECTED_BRANCHES; do
        if [ "$branch" = "$protected" ]; then
            if [ "$local_sha" = "$ZERO" ]; then
                echo "  BLOCKED  Deleting protected branch '$branch' is not allowed."
            else
                echo "  BLOCKED  Direct pushes to '$branch' are not allowed."
            fi
            blocked=1
        fi
    done
done

if [ "$blocked" -eq 1 ]; then
    cat <<'MSG'

  All changes go through a pull request:

    git switch develop && git pull
    git switch -c feature/PFX-<number>-<description>
    # ... edit and commit ...
    git push -u origin feature/PFX-<number>-<description>
    gh pr create --base develop

  Details are in CONTRIBUTING.md.

  If this is truly necessary (initial repository setup only):
    git push --no-verify

MSG
    exit 1
fi

exit 0
